pkgname=shellcheck
pkgver=0.11.0
pkgrel=1
pkgdesc='Static analysis and lint tool for shell scripts'
arch=('aarch64')
url='https://www.shellcheck.net'
license=('GPL-3.0-or-later')
options=('!debug')
source_aarch64=("$pkgname-$pkgver.tar.xz::https://github.com/koalaman/shellcheck/releases/download/v$pkgver/shellcheck-v$pkgver.linux.aarch64.tar.xz")
sha256sums_aarch64=('12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588')

package() {
    install -Dm755 \
        "$srcdir/shellcheck-v$pkgver/shellcheck" \
        "$pkgdir/usr/bin/shellcheck"
}
