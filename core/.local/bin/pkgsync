#!/bin/bash

set -euo pipefail

readonly dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
readonly machine_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/machine"

machine=""
[[ -f "$machine_file" ]] && machine=$(<"$machine_file")
readonly machine

package_list() {
    case "$machine" in
        arch-work-guest|fedora-work-guest)
            printf '%s\n' "$dotfiles_dir/machines/$machine/packages.txt"
            ;;
        *)
            printf '%s\n' "$dotfiles_dir/pkglist.txt"
            ;;
    esac
}

pkglist=$(package_list)
readonly pkglist

[[ -f "$pkglist" ]] || { echo "Missing $pkglist"; exit 1; }

case "${1:-}" in
    sync)
        echo "Installing packages..."
        if [[ "$machine" == arch-work-guest || "$machine" == fedora-work-guest ]]; then
            exec "$dotfiles_dir/install_work_guest.sh"
        fi
        yay -S --needed - < "$pkglist"
        ;;
    diff)
        echo "=== installed but not in list ==="
        if [[ "$machine" == fedora-work-guest ]]; then
            comm -23 \
                <(dnf repoquery --userinstalled --queryformat '%{name}' | sort -u) \
                <(sort -u "$pkglist")
        else
            comm -23 <(pacman -Qqe | sort) <(sort -u "$pkglist")
        fi
        echo ""
        echo "=== in list but not installed ==="
        if [[ "$machine" == fedora-work-guest ]]; then
            comm -23 \
                <(sort -u "$pkglist") \
                <(rpm -qa --queryformat '%{NAME}\n' | sort -u)
        else
            comm -23 <(sort -u "$pkglist") <(pacman -Qqe | sort)
        fi
        ;;
    path)
        printf '%s\n' "$pkglist"
        ;;
    *)
        echo "Usage: pkgsync {sync|diff|path}"
        echo "  sync  - install packages from list"
        echo "  diff  - show divergence from list"
        echo "  path  - print the active package list"
        ;;
esac
