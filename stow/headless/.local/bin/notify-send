#!/usr/bin/env bash
# The VM has no notification daemon, so this logs notifications to the journal
# instead, where the host's vm-notify picks them up.

set -Eeuo pipefail

[[ "$#" -ge 1 && "$#" -le 2 && -n "$1" ]] || {
    echo "Usage: notify-send SUMMARY [BODY]" >&2
    exit 2
}

# One line, which vm-notify splits on the tab.
summary=${1//[$'\t\n']/ }
body=${2:-}
body=${body//[$'\t\n']/ }
logger -t notify-send -- "$summary"$'\t'"$body"
