window-decoration = false
font-family = 0xProto Nerd Font
font-size = 18

background-opacity = 0
background = #000000
foreground = #dddddd
cursor-color = #cccccc
cursor-text = #111111

palette = 0=#000000
palette = 1=#cc0403
palette = 2=#19cb00
palette = 3=#cecb00
palette = 4=#0d73cc
palette = 5=#cb1ed1
palette = 6=#0dcdcd
palette = 7=#dddddd
palette = 8=#767676
palette = 9=#f2201f
palette = 10=#23fd00
palette = 11=#fffd00
palette = 12=#1a8fff
palette = 13=#fd28ff
palette = 14=#14ffff
palette = 15=#ffffff

window-padding-x = 8
window-padding-y = 0
window-padding-balance = true
window-padding-color = background
macos-titlebar-style = transparent

macos-option-as-alt = true

keybind = cmd+h=esc:h
keybind = cmd+j=esc:j
keybind = cmd+k=esc:k
keybind = cmd+l=esc:l
keybind = cmd+s=esc:s
keybind = cmd+m=esc:m
keybind = cmd+digit_1=esc:1
keybind = cmd+digit_2=esc:2
keybind = cmd+digit_3=esc:3
keybind = cmd+digit_4=esc:4
keybind = cmd+digit_5=esc:5
keybind = cmd+digit_6=esc:6
keybind = cmd+digit_7=esc:7
keybind = cmd+digit_8=esc:8
keybind = cmd+digit_9=esc:9
# digits 1-9 must be physical (digit_N) to replace the goto_tab defaults, but
# 0 must be unicode to replace reset_font_size, which is bound to the '0'
# codepoint; a physical cmd+digit_0 coexists with it and the menu shortcut wins.
keybind = cmd+0=esc:0

mouse-hide-while-typing = true

clipboard-write = allow
clipboard-read = ask
