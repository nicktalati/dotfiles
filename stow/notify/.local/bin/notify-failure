#!/usr/bin/env bash
# Runs as notify-failure@<unit>.service, from OnFailure= in critical units.

set -Eeuo pipefail

[[ "$#" -eq 1 ]] || { echo "Usage: notify-failure <unit>" >&2; exit 2; }

unit=$1
stamp="${XDG_STATE_HOME:-$HOME/.local/state}/notify-failure/$unit"

# A timer re-runs a broken unit every few minutes; remind hourly instead.
if [[ -n "$(find "$stamp" -mmin -60 2>/dev/null)" ]]; then
    exit 0
fi
mkdir -p "${stamp%/*}"
touch "$stamp"

# The unit's log stays out of the notification: when Gmail rejects a token,
# mbsync logs the XOAUTH2 exchange with the token in it.
notify-send -u critical -a systemd "$unit failed" \
    "$(systemctl --user show --property Description --value "$unit")"
