#!/usr/bin/env bash

set -Eeuo pipefail

readonly config="${XDG_CONFIG_HOME:-$HOME/.config}/backup/config"
readonly credentials="${XDG_CONFIG_HOME:-$HOME/.config}/restic/env"

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

[[ -f "$config" ]] || die "backup configuration not found: $config"
[[ -f "$credentials" ]] || \
    die "restic credentials not found: $credentials (enroll from Bitwarden; see README)"
# shellcheck source=/dev/null
source "$config"
# shellcheck source=/dev/null
source "$credentials"
export RESTIC_REPOSITORY

case "${1:-s3}" in
    s3) ;;
    usb)
        mountpoint -q "$BACKUP_MOUNT" || \
            die "backup drive is not mounted at $BACKUP_MOUNT; run mount_drive"
        export RESTIC_REPOSITORY="$BACKUP_MOUNT/restic"
        ;;
    *)
        printf 'usage: backup [s3|usb]\n' >&2
        exit 2
        ;;
esac

restic backup "${BACKUP_SOURCES[@]}"
restic forget --prune "${BACKUP_KEEP[@]}"
