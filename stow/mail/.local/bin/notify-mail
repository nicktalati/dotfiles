#!/bin/bash

set -euo pipefail

readonly nm_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/notify-mail"
readonly nm_notified="$nm_state_dir/notified"

[[ "$#" -eq 1 ]] || { echo "Usage: notify-mail <mailbox-path>"; exit 1; }

mailbox=$1
[[ -d "$mailbox" ]] || { echo "Directory does not exist: $mailbox"; exit 1; }

new="$mailbox/new"
[[ -d "$new" ]] || { echo "Not a valid mailbox (no 'new' subdir): $mailbox"; exit 1; }

mkdir -p "$nm_state_dir"
touch "$nm_notified"

# The timer's sync and goimapnotify's can finish together, and both would
# notify about the same message.
exec 9>>"$nm_notified"
flock 9

# The first header line named $1 in message $2, or nothing if it has none.
header() {
    sed -n "/^\$/q; /^$1: /I{p;q}" "$2"
}

notify() {
    local file="$1"
    local to from subject
    to=$(header To "$file" | sed "s/^[Tt]o: //")
    from=$(header From "$file")
    subject=$(header Subject "$file")
    if ! grep -Fxq "$file" "$nm_notified"; then
        echo "$file" >> "$nm_notified"
        if ! command -v notify-send &>/dev/null || ! notify-send "$from" "$subject"; then
            printf 'new mail: %s | %s | %s\n' "$to" "$from" "$subject"
        fi
    fi
}

shopt -s nullglob
files=("$new"/*)
shopt -u nullglob

for file in "${files[@]}"; do
    notify "$file"
done
