#!/usr/bin/env bash

set -Eeuo pipefail

readonly config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/isync/accounts"
readonly oauth_dir="$HOME/.local/share/mail/oauth"

sync_account() {
    local account=$1
    local mailbox=${2:-}
    local config="$config_dir/$account.conf"
    local token="$oauth_dir/$account"

    [[ -f "$config" ]] || {
        printf 'error: mail account is not configured: %s\n' "$account" >&2
        return 1
    }
    [[ -f "$token" ]] || {
        printf 'error: OAuth token is unavailable: %s (run mail-enroll %s)\n' \
            "$token" "$account" >&2
        return 1
    }

    # mbsync creates mailboxes but not the Maildir store that holds them, so on
    # a machine that has never synced every channel fails with "cannot open
    # store". The store directory is not named after the account, so take it
    # from the account's own configuration.
    local store
    store=$(awk '$1 == "Path" { print $2; exit }' "$config")
    [[ -n "$store" ]] || {
        printf 'error: no Maildir store path in %s\n' "$config" >&2
        return 1
    }
    mkdir -p "${store/#\~/$HOME}"

    if [[ -n "$mailbox" ]]; then
        mbsync --config "$config" "$account:$mailbox"
    else
        mbsync --config "$config" --all
    fi
}

if (($#)); then
    [[ "$#" -le 2 ]] || {
        printf 'usage: mail-sync [ACCOUNT [MAILBOX]]\n' >&2
        exit 2
    }
    sync_account "$@"
else
    shopt -s nullglob
    configs=("$config_dir"/*.conf)
    ((${#configs[@]})) || {
        printf 'error: no mail accounts are configured in %s\n' "$config_dir" >&2
        exit 1
    }
    synced=false
    for config in "${configs[@]}"; do
        account=$(basename "$config" .conf)
        [[ -f "$oauth_dir/$account" ]] || continue
        sync_account "$account"
        synced=true
    done
    $synced || {
        printf 'error: no OAuth tokens are available in %s\n' "$oauth_dir" >&2
        exit 1
    }
fi

notmuch new
