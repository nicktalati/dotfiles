#!/usr/bin/env bash

set -Eeuo pipefail

readonly config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/isync/accounts"
readonly oauth_dir="$HOME/.local/share/mail/oauth"
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mail-sync"

# mbsync exits 1 for every error, but most are the network dropping out while
# the host sleeps, or a run colliding with goimapnotify's, and the next run
# recovers. Those exit 75, which mbsync@.service counts as success, so the unit
# fails (and notify-failure alerts) only on errors someone has to fix, or once
# they have gone on for this many seconds of uptime. Uptime stops while the
# host sleeps, so a night of brief wakes without network never adds up to it.
readonly transient='Socket error|Cannot resolve server|Cannot connect to|is locked|returned an error: System Error'
readonly transient_limit=1800

sync_account() {
    local account=$1
    local mailbox=${2:-}
    local config="$config_dir/$account.conf"
    local token="$oauth_dir/$account"

    [[ -f "$config" ]] || {
        printf 'error: mail account is not configured: %s\n' "$account" >&2
        return 1
    }
    [[ -f "$token" ]] || {
        printf 'error: OAuth token is unavailable: %s (run mail-enroll %s)\n' \
            "$token" "$account" >&2
        return 1
    }

    # mbsync creates mailboxes but not the Maildir store that holds them, so on
    # a machine that has never synced every channel fails with "cannot open
    # store". The store directory is not named after the account, so take it
    # from the account's own configuration.
    local store inbox
    store=$(awk '$1 == "Path" { print $2; exit }' "$config")
    inbox=$(awk '$1 == "Inbox" { print $2; exit }' "$config")
    [[ -n "$store" && -n "$inbox" ]] || {
        printf 'error: no Maildir store Path or Inbox in %s\n' "$config" >&2
        return 1
    }
    store=${store/#\~/$HOME}
    inbox=${inbox/#\~/$HOME}
    mkdir -p "$store"

    local target=(--all)
    [[ -z "$mailbox" ]] || target=("$account:$mailbox")
    local errors status=0
    { errors=$(mbsync --config "$config" "${target[@]}" 2>&1 >&3) || status=$?; } 3>&1
    [[ -z "$errors" ]] || printf '%s\n' "$errors" >&2

    # Every sync notifies, not only goimapnotify's, so mail that arrives while
    # its IDLE connection is down still does, as does mail a sync fetched
    # before failing. notify-mail skips messages it has already notified about.
    [[ ! -d "$inbox" ]] || notify-mail "$inbox"

    local failing="$state_dir/$account.failing-since"
    if ((status)) && grep -qE "$transient" <<<"$errors"; then
        local now since=
        now=$(cut -d . -f 1 /proc/uptime)
        [[ ! -f "$failing" ]] || since=$(<"$failing")
        # A start later than now is from before a reboot.
        if [[ -z "$since" ]] || ((since > now)); then
            since=$now
            mkdir -p "$state_dir"
            printf '%s\n' "$since" > "$failing"
        fi
        ((now - since >= transient_limit)) || return 75
        printf 'error: transient errors for %d minutes of uptime\n' \
            $(((now - since) / 60)) >&2
    fi
    ((status == 0)) || return "$status"
    rm -f "$failing"
}

if (($#)); then
    [[ "$#" -le 2 ]] || {
        printf 'usage: mail-sync [ACCOUNT [MAILBOX]]\n' >&2
        exit 2
    }
    sync_account "$@"
else
    shopt -s nullglob
    configs=("$config_dir"/*.conf)
    ((${#configs[@]})) || {
        printf 'error: no mail accounts are configured in %s\n' "$config_dir" >&2
        exit 1
    }
    synced=false
    for config in "${configs[@]}"; do
        account=$(basename "$config" .conf)
        [[ -f "$oauth_dir/$account" ]] || continue
        sync_account "$account"
        synced=true
    done
    $synced || {
        printf 'error: no OAuth tokens are available in %s\n' "$oauth_dir" >&2
        exit 1
    }
fi

notmuch new
