[Unit]
Description=Watch IMAP account %i for mailbox changes
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/env goimapnotify -conf %h/.config/goimapnotify/%i.yaml
Environment="PATH=/usr/local/bin:/usr/bin:%h/.local/bin"
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
